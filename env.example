:root {
  --purple: #534AB7;
  --purple-bg: #EEEDFE;
  --purple-dark: #3C3489;
  --green: #0F6E56;
  --green-bg: #E1F5EE;
  --red: #A32D2D;
  --red-bg: #FCEBEB;
  --amber: #854F0B;
  --amber-bg: #FAEEDA;
  --bg: #f7f6fb;
  --card: #ffffff;
  --soft: #f1eff8;
  --text: #05051f;
  --muted: #5e5a78;
  --border: #dcd8ea;
}
* { box-sizing: border-box; }
body { margin: 0; font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: var(--bg); color: var(--text); }
button, input, textarea { font: inherit; }
button { cursor: pointer; }
.app-shell { min-height: 100vh; background: var(--bg); }
.topbar { min-height: 68px; background: var(--card); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 18px; position: sticky; top: 0; z-index: 5; }
.logo { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 18px; }
.logo-mark { width: 36px; height: 36px; background: var(--purple); color: white; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; }
.toggle-wrap { display: flex; background: #f0eff6; border: 1px solid var(--border); border-radius: 15px; padding: 4px; gap: 4px; }
.toggle-wrap button { border: none; background: transparent; padding: 9px 18px; border-radius: 12px; display: flex; gap: 7px; align-items: center; color: var(--muted); font-size: 18px; }
.toggle-wrap button.active { background: white; color: var(--text); box-shadow: 0 1px 4px rgba(0,0,0,0.10); font-weight: 700; }
.avatars { display: flex; gap: 8px; }
.avatar { width: 34px; height: 34px; border-radius: 50%; color: white; display: inline-flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; }
.kaylee { background: var(--purple); }
.adam { background: var(--green); }
.main { display: flex; min-height: calc(100vh - 68px); }
.sidebar { width: 270px; background: var(--card); border-right: 1px solid var(--border); padding: 22px 0; flex-shrink: 0; }
.nav-label { font-size: 13px; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); padding: 0 16px; margin-bottom: 9px; }
.nav-item { width: 100%; border: none; background: transparent; padding: 11px 18px; display: flex; align-items: center; gap: 12px; text-align: left; color: var(--muted); border-left: 3px solid transparent; font-size: 18px; }
.nav-item:hover { background: #f6f4fb; }
.nav-item.active { background: var(--purple-bg); color: var(--purple-dark); border-left-color: var(--purple); font-weight: 700; }
.side-note, .sync-note { margin: 18px 14px; padding: 14px; background: #f3f2f7; border-radius: 14px; font-size: 14px; color: var(--muted); }
.side-note strong, .sync-note strong { color: var(--text); }
.sync-note { background: var(--green-bg); color: #0a4a3a; }
.content { flex: 1; padding: 30px; overflow: auto; }
.page-header { display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; margin-bottom: 24px; }
.page-header h1 { margin: 0; font-size: 31px; line-height: 1.1; }
.page-header p { margin: 8px 0 0; color: var(--muted); font-size: 18px; max-width: 720px; }
.actions { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
.btn { border: none; border-radius: 12px; padding: 10px 15px; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 7px; font-weight: 700; white-space: nowrap; }
.btn.primary { background: var(--purple); color: white; }
.btn.ghost { background: white; border: 1px solid var(--border); color: var(--text); }
.btn.warning { background: var(--amber-bg); color: var(--amber); border: 1px solid #dfc38d; }
.btn.green { background: var(--green); color: white; }
.btn.tiny { padding: 6px 9px; font-size: 12px; margin-top: 8px; }
.stats-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; margin-bottom: 24px; }
.stat-card, .panel, .table-card, .day-card { background: var(--card); border: 1px solid var(--border); border-radius: 18px; padding: 20px; box-shadow: 0 16px 30px rgba(40, 32, 80, 0.04); }
.stat-label, .stat-sub, .panel p, small { color: var(--muted); }
.stat-label { font-size: 16px; }
.stat-val { font-size: 31px; font-weight: 900; margin-top: 8px; }
.stat-sub { margin-top: 5px; font-size: 15px; }
.grid.two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
.panel { margin-bottom: 18px; }
.panel h2 { margin: 0 0 16px; font-size: 27px; }
.panel h3 { margin-bottom: 8px; }
.panel-head { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin-bottom: 12px; }
.task-card { display: flex; gap: 14px; padding: 16px; border-radius: 14px; background: #f7f6fb; margin-bottom: 10px; border-left: 4px solid transparent; }
.task-card strong { font-size: 18px; }
.task-card.urgent { border-left-color: var(--red); }
.task-card.warning { border-left-color: var(--amber); }
.task-card.good { border-left-color: var(--green); }
.task-card.normal { border-left-color: var(--purple); }
.check { width: 22px; height: 22px; border: 2px solid #bbb6ca; border-radius: 50%; margin-top: 2px; background: white; flex-shrink: 0; }
.brief-item { padding: 13px 14px; background: #f7f6fb; border-radius: 12px; margin-bottom: 10px; }
.brief-item.urgent { background: var(--red-bg); color: var(--red); }
.brief-item.good { background: var(--green-bg); color: var(--green); }
.action-panel.scanUse { border-left: 5px solid var(--amber); }
.form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.scan-row { display: flex; gap: 10px; align-items: center; }
input, textarea { width: 100%; border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px; background: white; color: var(--text); }
textarea { min-height: 130px; resize: vertical; margin: 12px 0; }
.table-card { overflow-x: auto; padding: 20px; }
table { width: 100%; border-collapse: collapse; min-width: 740px; }
th, td { padding: 13px; border-bottom: 1px solid var(--border); text-align: left; }
th { color: var(--muted); text-transform: uppercase; font-size: 13px; letter-spacing: .05em; }
td small { display: block; margin-top: 3px; color: var(--muted); }
.day-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 10px; }
.day-card h3 { margin-top: 0; }
.suggestion.urgent { border-left: 5px solid var(--red); }
.suggestion.soon { border-left: 5px solid var(--amber); }
.suggestion.seasonal { border-left: 5px solid var(--green); }
.status { display: inline-flex; border-radius: 999px; padding: 4px 10px; font-weight: 700; font-size: 13px; margin-bottom: 10px; }
.status.good { background: var(--green-bg); color: var(--green); }
.status.warning { background: var(--amber-bg); color: var(--amber); }
@media (max-width: 900px) {
  .main { flex-direction: column; }
  .sidebar { width: 100%; border-right: none; border-bottom: 1px solid var(--border); }
  .stats-row, .grid.two, .day-grid, .form-grid { grid-template-columns: 1fr; }
  .page-header { flex-direction: column; }
  .topbar { gap: 10px; flex-wrap: wrap; height: auto; padding: 12px; }
  .toggle-wrap button { font-size: 15px; }
  .content { padding: 18px; }
}
